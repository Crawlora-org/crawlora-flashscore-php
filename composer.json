{
  "name": "crawlora/flashscore",
  "description": "Flashscore client for the Crawlora hosted API",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crawlora\\Flashscore\\": "src/Crawlora/Flashscore/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crawlora\\Flashscore\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/client_test.php"
  },
  "homepage": "https://github.com/Crawlora-org/crawlora-flashscore",
  "support": {
    "source": "https://github.com/Crawlora-org/crawlora-flashscore"
  }
}
